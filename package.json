{
  "name": "agent-practice",
  "version": "0.0.0",
  "private": true,
  "description": "How and why I work with coding agents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avi2d/agent-practice.git"
  },
  "author": {
    "name": "avi2d",
    "email": "avi2dg@gmail.com"
  },
  "type": "module",
  "scripts": {
    "build": "checks-effect-scope && bun run site",
    "site": "bun src/site/build.ts",
    "lint": "oxlint && checks-lint && sh scripts/check-blog-phrases.sh",
    "typecheck": "tsc --noEmit && effect-tsgo diagnostics --project tsconfig.json --format text --strict",
    "test": "checks-test",
    "test:fast": "checks-test --changed",
    "test:unit": "checks-test --tier=unit"
  },
  "devDependencies": {
    "@avi2dg/checks": "0.112.0",
    "@hughescr/stryker-bun-runner": "1.4.0",
    "@stryker-mutator/core": "10.0.0",
    "@types/bun": "1.4.5",
    "effect": "4.0.0"
  },
  "trustedDependencies": [
    "@swc/core"
  ]
}
